# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=nice_circle

# Server
PORT=3000
NODE_ENV=development

# Klaviyo (add later when client provides)
KLAVIYO_API_KEY=your_api_key_here
KLAVIYO_LIST_ID=your_list_id_here

# Shopify (add later when client provides)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SHOP_URL=your_shop_url_here

# Email (for demo, use Mailtrap)
MAILTRAP_USER=your_mailtrap_user_here
MAILTRAP_PASS=your_mailtrap_password_here
MAILTRAP_HOST=send.mailtrap.io
MAILTRAP_PORT=2525
