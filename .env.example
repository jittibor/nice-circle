# ═══════════════════════════════════════════════════════════════════
# N1CE Circle · Environment Variables
# Copy this file to .env and fill in values before running the webhook.
# ═══════════════════════════════════════════════════════════════════

# ─── Database (existing — leave as-is unless you change stack) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=nice_circle

# ─── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Shopify webhook security ─────────────────────────────────
# Get this from Shopify admin → Settings → Notifications → Webhooks →
# click any webhook → reveal "Webhook signature / API secret key".
SHOPIFY_WEBHOOK_SECRET=

# ─── SMTP credentials (for sending emails) ───────────────────
#
# Pick ONE of these tiers:
#
# ┌────────────────────┬──────────────────┬─────────────────────┬──────────────┐
# │ Tier               │ Volume/day        │ Provider            │ Real cost    │
# ├────────────────────┼──────────────────┼─────────────────────┼──────────────┤
# │ dev / small launch │ up to 500/day    │ Gmail SMTP          │ $0           │
# │ medium             │ up to ~2k/day    │ Google Workspace    │ $6/mo        │
# │ PRODUCTION (10k+)  │ unlimited        │ Amazon SES          │ $0.10/1k     │
# │ managed            │ unlimited        │ Resend / SendGrid   │ $20-90/mo    │
# └────────────────────┴──────────────────┴─────────────────────┴──────────────┘
#
# ══ OPTION A — Gmail (free, dev only, 500/day limit) ══
# Create app password at https://myaccount.google.com/apppasswords (2FA required)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.name@gmail.com
# SMTP_PASS=your-16-char-app-password
#
# ══ OPTION B — Amazon SES (RECOMMENDED for production, 10k+/day) ══
# 1. Create AWS account, verify your sending domain
# 2. IAM → create SMTP credentials → download .csv
# 3. Request production access (removes 200/day sandbox cap)
# Cost: $0.10 per 1,000 emails — that's $1 per 10,000 or $100 per million.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<SES SMTP username — not your AWS key>
# SMTP_PASS=<SES SMTP password>
#
# ══ OPTION C — Resend (easy managed, 3k/mo free, $20/mo for 50k) ══
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_<your-api-key>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Connection pooling — enable for high-volume sends (SES/Resend).
# Set to "true" once you're on a provider that handles concurrent connections.
SMTP_POOL=false
SMTP_MAX_CONNECTIONS=10
SMTP_MAX_MESSAGES=100

# The "From" address shown on received emails.
# For Gmail, must match SMTP_USER (Gmail rewrites From → authenticated user).
FROM_EMAIL=hello@n1ce.com
FROM_NAME=N1CE Circle

# ─── Asset base URL (for image URLs in outgoing emails) ──────
# Where public/ is deployed. Use localhost for local testing.
BASE_URL=https://YOUR-SITE.netlify.app

# ─── Optional ────────────────────────────────────────────────
# Default flavour sent when customer has no flavour tag/metafield
DEFAULT_FLAVOR=berry

# ─── Legacy (not currently used, safe to leave blank) ────────
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_URL=
MAILTRAP_USER=
MAILTRAP_PASS=
